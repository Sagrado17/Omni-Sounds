rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'pascoalbernabe678@gmail.com' ||
        request.auth.token.email.lower() == 'pascoalbernabe678@gamail.com' ||
        request.auth.token.email.lower() == 'pdacomercial64@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Connection Health / Testing
    match /test/{testId} {
      allow read: if true;
    }

    // Beats Collection: Catálogo público, gestão pelo admin
    match /beats/{beatId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Projects Collection: Portfólio público, gestão pelo admin
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings Collection: Configurações do estúdio públicas para leitura, edição pelo admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings Collection: Clientes podem solicitar agendamento, admin lê e atualiza
    match /bookings/{bookingId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Purchases Collection: Clientes podem registrar pedidos de compra de beats, admin lê e atualiza
    match /purchases/{purchaseId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Custom Beat Orders Collection: Clientes podem encomendar beats personalizados, admin lê e atualiza
    match /custom_beats/{orderId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Users Collection: Usuário lê o seu próprio perfil, admin gerencia
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAdmin();
    }
  }
}
